{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ripple P0 replay",
  "type": "object",
  "required": [
    "session_id",
    "campaign_id",
    "version",
    "map_id",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "map_id": {
      "const": "komodo_v1"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "dir"
            ],
            "properties": {
              "type": {
                "const": "MOVE"
              },
              "dir": {
                "enum": [
                  "N",
                  "S",
                  "E",
                  "W"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "node_id"
            ],
            "properties": {
              "type": {
                "const": "GATHER"
              },
              "node_id": {
                "enum": [
                  "wood_1",
                  "stone_1",
                  "metal_1"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "REPAIR_BRIDGE"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "CRAFT_WELL"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "BUILD_WELL"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "CONNECT_WATER"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "FINISH"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "cell"
            ],
            "properties": {
              "type": {
                "const": "PLACE_PIPE"
              },
              "cell": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "cell"
            ],
            "properties": {
              "type": {
                "const": "REMOVE_PIPE"
              },
              "cell": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        ]
      }
    }
  }
}
